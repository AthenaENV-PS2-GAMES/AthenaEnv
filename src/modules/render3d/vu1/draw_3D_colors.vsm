                    maddw.xyzw VF09, VF04, VF05w    ilw.y VI02, 26(VI00)
                    mulax.xyzw ACC, VF01, VF06x     loi 0x45000000
                    madday.xyzw ACC, VF02, VF06y    nop
                    maddaz.xyzw ACC, VF03, VF06z    nop
