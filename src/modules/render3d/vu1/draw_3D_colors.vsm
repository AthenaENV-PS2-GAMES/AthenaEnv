                    nop                             move VF07, VF00
                    nop                             move VF08, VF00
                    nop                             move VF10, VF00
                    nop                             fcset 0
                    nop                             iaddiu VI06, VI05, 1
                    nop                             iadd VI07, VI00, VI01
vertexLoop:
                    nop                             lq VF11, 2(VI04)
