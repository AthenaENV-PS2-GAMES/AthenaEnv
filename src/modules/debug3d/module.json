{
  "id": "debug3d",
  "name": "Debug3D",
  "description": "World-space debug lines for 3D: lines, boxes, spheres, axes, grids, camera frustums and mesh normals, projected and clipped on the EE and drawn as GS lines over the frame, for one frame or N seconds.",
  "category": "Graphics",
  "version": "1.0.0",
  "required": false,
  "default": false,
  "sources": [
    "native/debug3d.c",
    "native/debug3d_gs.c"
  ],
  "dependencies": {
    "modules": [
      "graphics",
      "camera3d",
      "model3d",
      "matrix4",
      "loop"
    ],
    "iop": [],
    "ee_libs": []
  },
  "native": {
    "shutdown": "athena_debug3d_module_shutdown"
  },
  "quickjs": {
    "sources": [
      "quickjs/ath_debug3d.c"
    ],
    "module_name": "Debug3D",
    "global_alias": "Debug3D",
    "init_func": "athena_debug3d_js_init",
    "cleanup_func": "athena_debug3d_js_cleanup"
  },
  "types": "debug3d.d.ts"
}
