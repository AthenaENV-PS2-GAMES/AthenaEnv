                    sub.xyzw VF04, VF00, VF00       nop
                    nop                             nop
                    nop                             nop
                    add.xy VF04, VF05, VF02         mr32 VF10, VF05
                    nop                             sq VF09, 3(VI04)
                    nop                             nop
                    nop                             nop
                    nop                             nop
