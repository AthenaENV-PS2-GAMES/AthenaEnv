                    nop                             mtir VI03, VF07w
                    nop                             nop
                    nop                             ibeq VI03, VI00, ignore_face_culling
                    nop                             nop
                    nop                             iaddiu VI03, VI00, 0x20
ignore_face_culling:
                    nop                             xtop VI04
                    nop                             lq VF11, 0(VI04)
                    nop                             iaddiu VI05, VI04, 194
                    nop                             move VF10, VF00
                    nop                             xitop VI01
                    nop                             sq VF11, 0(VI05)
