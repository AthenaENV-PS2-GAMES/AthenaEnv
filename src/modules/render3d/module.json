{
  "id": "render3d",
  "name": "Render3D",
  "description": "Opaque color and perspective-correct textured rendering, VU1 skinning with optional textures, Gouraud diffuse lighting, precise native clipping, retained batches and retained DMA geometry.",
  "category": "Graphics",
  "version": "1.8.0",
  "default": false,
  "sources": [
    "native/render3d.c",
    "native/render3d_clip.c",
    "native/render3d_shade.c",
    "native/render3d_gs.c",
    "vu1/draw_3D_colors.vsm",
    "vu1/draw_3D_diffuse.vsm",
    "vu1/draw_3D_texture.vsm",
    "vu1/draw_3D_skinned.vsm",
    "vu1/draw_3D_near.vsm",
    "vu1/draw_3D_morph.vsm",
    "vu1/draw_3D_indexed.vsm",
    "vu1/draw_3D_indexed_skinned.vsm",
    "vu1/draw_3D_indexed_morph.vsm"
  ],
  "dependencies": {
    "modules": [
      "graphics",
      "model3d",
      "camera3d",
      "lights"
    ],
    "iop": [],
    "ee_libs": []
  },
  "native": {
    "shutdown": "athena_render3d_module_shutdown"
  },
  "quickjs": {
    "sources": [
      "quickjs/ath_render3d.c"
    ],
    "module_name": "Render3D",
    "global_alias": "Render3D",
    "init_func": "athena_render3d_js_init",
    "cleanup_func": "athena_render3d_js_cleanup"
  },
  "types": "render3d.d.ts"
}
